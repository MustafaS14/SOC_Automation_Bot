# Copy to .env on the soc-siem VM and fill in. Never commit the real .env (it is in .gitignore).
# Keep the file private: chmod 600 .env
# Admin password for the Splunk web UI (user: admin). Use a long random value.
SPLUNK_PASSWORD=change-me
# HEC token: any UUID, for example from: uuidgen
SPLUNK_HEC_TOKEN=00000000-0000-0000-0000-000000000000
