# --- Discord ---
DISCORD_TOKEN=
# Sync slash commands to one guild for instant availability (recommended)
DISCORD_GUILD_ID=
# Comma-separated channel IDs where the bot accepts commands (empty = any channel in the guild)
ALLOWED_CHANNEL_IDS=
# Channel that receives an audit trail of every command (optional)
AUDIT_CHANNEL_ID=

# --- RBAC (comma-separated Discord role IDs). Higher tiers inherit lower ones. ---
# READ:     /incident list, /incident show, /enrich
# TRIAGE:   /incident comment, /incident close
# RESPONSE: /isolate, /unisolate
RBAC_READ_ROLE_IDS=
RBAC_TRIAGE_ROLE_IDS=
RBAC_RESPONSE_ROLE_IDS=

# Hosts that must never be isolated from chat (fnmatch patterns, comma-separated)
ISOLATION_DENYLIST=dc*,*-dc-*,adfs*

# --- Azure (service principal, read by azure-identity DefaultAzureCredential) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Microsoft Sentinel workspace ---
SENTINEL_SUBSCRIPTION_ID=
SENTINEL_RESOURCE_GROUP=
SENTINEL_WORKSPACE_NAME=
SENTINEL_API_VERSION=2024-03-01

# --- Microsoft Defender for Endpoint ---
DEFENDER_API_BASE=https://api.securitycenter.microsoft.com

# --- Threat intel enrichment (optional) ---
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# --- Misc ---
AUDIT_LOG_PATH=audit.jsonl
LOG_LEVEL=INFO
# Use in-memory fake Sentinel/Defender/TI data (great for demos and recording the walkthrough)
SOC_BOT_MOCK=false
