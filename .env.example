# --- Discord ---
# Secrets can be 1Password references instead of values, e.g. DISCORD_TOKEN=op://SOC-Lab/discord/token
# and the program started with: op run --env-file=.env -- python -m soc_bot   (see docs/secrets.md)
DISCORD_TOKEN=
# Sync slash commands to one guild for instant availability (recommended)
DISCORD_GUILD_ID=
# Channel IDs where the bot accepts commands (required; empty = bot refuses to start)
ALLOWED_CHANNEL_IDS=
# Channel that receives new-alert embeds with Acknowledge/Enrich/Isolate buttons
ALERT_CHANNEL_ID=
# Channel that receives an audit trail of every command (optional)
AUDIT_CHANNEL_ID=

# --- RBAC (comma-separated Discord role IDs). Higher tiers inherit lower ones. ---
# VIEWER:   /ask only, with summary-level answers (no hostnames, IPs or commands)
# READ:     /incident list, /incident show, /enrich, /hunt, and /ask with analyst-level answers
# TRIAGE:   /incident comment, /incident close
# RESPONSE: /isolate, /unisolate, and /ask about isolation
# ADMIN:    everything, including /ask about the audit log
RBAC_VIEWER_ROLE_IDS=
RBAC_READ_ROLE_IDS=
RBAC_TRIAGE_ROLE_IDS=
RBAC_RESPONSE_ROLE_IDS=
RBAC_ADMIN_ROLE_IDS=

# Hosts that must never be isolated from chat (fnmatch patterns, comma-separated)
ISOLATION_DENYLIST=dc*,*-dc-*,adfs*

# --- Alert webhook (Splunk -> bot) ---
# Loopback by default. Anything wider (e.g. the SIEM host-only address) sends the secret in clear text over
# plain HTTP, so use it only on a trusted network or behind a TLS reverse proxy.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8765
# Required, except in mock mode, where the webhook is disabled when this is empty.
# Callers send it in the X-Webhook-Secret header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Max authenticated webhook requests per minute, counted across all senders (not per sender).
# A leaked secret can use up this budget; rotate WEBHOOK_SECRET if that happens.
WEBHOOK_RATE_LIMIT=30
# Hostnames (no scheme, port or path) that alert links may point at, comma-separated. The hostname of
# SPLUNK_URL is always allowed; ports are ignored. With neither set, alert links are dropped.
WEBHOOK_LINK_HOSTS=
DB_PATH=incidents.db

# --- Splunk REST (/hunt, optional). Create a token under Settings > Tokens. ---
# Format: https://<splunk-host>:8089
SPLUNK_URL=
SPLUNK_TOKEN=
# Set to false only for a self-signed lab certificate
SPLUNK_VERIFY_TLS=true

# --- Splunk HEC (audit forwarding to index soc_audit, optional) ---
# Format: https://<splunk-host>:8088/services/collector/event
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=

# --- SSH isolation (optional) ---
# Allow-list of isolatable hosts. Format: name=ip,name=ip
# A name typed in chat must equal an entry exactly (a bare short name may match one entry's short part).
RESPONDER_HOSTS=
RESPONDER_USER=responder
# Path to the bot's private key; restrict the public key as described in infra/responder/README.md
RESPONDER_SSH_KEY=
# Defaults to ~/.ssh/known_hosts; host keys are always verified
RESPONDER_KNOWN_HOSTS=

# --- Threat intel enrichment (optional) ---
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# --- AI assistant (optional; see docs/ai-triage-design.md) ---
# off (default), claude_code (runs `claude -p`, installed and logged in for the user running the bot),
# or mock (only together with SOC_BOT_MOCK=true).
AI_BACKEND=off
AI_COMMAND=claude
# Leave empty for Claude Code's default model
AI_MODEL=
AI_TIMEOUT_SECONDS=90
# Limits that protect the personal subscription's allowance
AI_USER_QUESTIONS_PER_HOUR=12
AI_AUTO_NOTES_PER_HOUR=6
AI_DAILY_CALLS=150
# Most rows of data the assistant may be shown per lookup
AI_MAX_ROWS=20

# --- Misc ---
AUDIT_LOG_PATH=audit.jsonl
LOG_LEVEL=INFO
# Use in-memory fake incidents/Splunk/SSH/TI data (demos and recording the walkthrough)
SOC_BOT_MOCK=false

# --- Web console (python -m soc_web; see docs/web-console.md) ---
# Signs the session cookie. Required (mock mode makes a throwaway one). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SOC_WEB_SECRET_KEY=
# Loopback by default. Anything wider is plain HTTP: put a TLS reverse proxy in front.
SOC_WEB_HOST=127.0.0.1
SOC_WEB_PORT=8080
SOC_WEB_USERS_DB=web_users.db
# Cookies are marked Secure. Set false only for a plain-HTTP lab address (not localhost).
SOC_WEB_SECURE_COOKIES=true
SOC_WEB_SESSION_HOURS=8
SOC_WEB_MAX_FAILED_LOGINS=5
SOC_WEB_LOCKOUT_MINUTES=15
# Host names the console answers to, comma separated. Defaults to loopback plus SOC_WEB_HOST; required in practice
# when listening on 0.0.0.0 (otherwise any Host header is accepted and a warning is logged).
SOC_WEB_ALLOWED_HOSTS=
# Number of TLS reverse proxies in front (0 = none). Above 0, X-Forwarded-For/-Proto/-Host from the nearest proxy are
# believed, so the sign-in limit and the audit log see the real client address. Never set it without a proxy.
SOC_WEB_TRUSTED_PROXIES=0
